# Copy to contracts/.env and fill in. That file is gitignored and must stay
# that way — it holds a key that can spend real money.
#
# Every variable here is read by something in script/. Nothing else is.

# --- always needed ---

# Node the scripts talk to. foundry.toml wires this to the `arc_testnet`
# profile, so `forge script --rpc-url arc_testnet` resolves through here.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# The account that broadcasts. Hex, with the 0x.
#
# Treat anything that has ever been in this file on a shared or untrusted
# machine as burned, and never reuse a testnet key on mainnet — a key is only
# as safe as the least careful place it has been.
DEPLOYER_PRIVATE_KEY=0x

# --- deployment ---

# Who owns the deployed contracts: withdraws protocol fees, sets the factory
# once. Defaults to the deployer if unset, which is almost never what you
# want — deploy keys live on disk and owner keys should not.
PROTOCOL_OWNER=

# Uniswap v4's PoolManager, which the LiquidityLocker is built around.
#
# Leave unset on testnet: v4 is not deployed on Arc testnet, and the locker
# accepts a zero address by holding graduation funds without seeding a pool.
#
# On mainnet this is the single most important line in this file. It is
# immutable once the locker is constructed, and the locker has no withdraw
# function — so deploying with this unset or wrong means any coin that
# graduates sends its USDC and tokens somewhere they can never come back
# from. Verify the address has code on the chain you are deploying to before
# broadcasting. Deploy.s.sol checks that for you and will refuse; do not
# route around it.
POOL_MANAGER=

# --- post-deployment, for the scripts that act on live contracts ---

# Filled in from a deploy's output. Seed.s.sol and Lifecycle.s.sol read these
# to talk to contracts that already exist.
AROMA_FACTORY=
CURVE_MANAGER=

# --- pool system (script/DeployPool.s.sol) ---

# The pool system reuses POOL_MANAGER above - same Uniswap v4 singleton, so
# there is nothing extra to set. On Arc mainnet (5042) it is
# 0x8366a39cc670b4001a1121b8f6a443a643e40951, per Uniswap's sdk-core address
# table and their UniswapX chain playbook, which agree.
#
# Unlike the curve system, this one cannot be deployed with POOL_MANAGER
# unset. There is no degraded mode: the pool *is* the product. And there is
# no testnet path at all - Uniswap is not deployed on Arc testnet at any
# version, every canonical v3 and v4 address returns empty code on chain
# 5042002. Deploy against mainnet or exercise against a fork.
#
# DeployPool.s.sol refuses an address with no code on the target chain, and
# PoolVault refuses it again in its constructor. Do not route around either.

# Filled in from a DeployPool run, for scripts acting on live contracts.
POOL_VAULT=
POOL_FACTORY=

# --- tests ---

# Archive-capable Ethereum endpoint for the pool tests, which fork mainnet to
# reach a real deployed PoolManager. Defaults to a public one. Point this at
# Arc mainnet once an endpoint exists and the same tests exercise the real
# target chain; nothing in them is Ethereum-specific.
ETH_RPC_URL=

# Arc mainnet, for deploying. Circle has not published a public endpoint yet
# ("mainnet endpoints and parameters are published separately when
# available"), and the third-party chainlists do not carry it - dRPC and 1rpc
# both answer "unknown network". A provider account is needed for now.
ARC_MAINNET_RPC_URL=
