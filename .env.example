# Copy to .env.local and fill in. Everything here is public (NEXT_PUBLIC_),
# so nothing secret belongs in this file — the deployer key lives in
# contracts/.env, which is gitignored.

# Reown Cloud project ID — free, from https://cloud.reown.com
# Without it the app still runs, but only with injected browser wallets
# (MetaMask, Rabby). WalletConnect and the AppKit modal need this set.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Which chain this build talks to — see src/lib/network.ts. One of:
#   robinhood-testnet  (default) Robinhood Chain testnet
#   robinhood          Robinhood Chain mainnet
#   arc                Arc mainnet, the pool system and native-USDC clubs
#   local              an anvil fork; addresses from the NEXT_PUBLIC_LOCAL_* vars
NEXT_PUBLIC_AROMA_NETWORK=robinhood-testnet

# RPC endpoints for that chain, best first. Only the one matching the network
# above is read. Comma-separate to supply more than one and they go behind a
# fallback transport: if the first errors, the next is tried. Reads are cheap
# to retry, but the write path is the one that touches money — a single
# provider having a bad minute should not mean nobody can sell.
#
# Robinhood's own docs recommend an Alchemy-backed URL for production; the
# public endpoint is rate-limited and fine for development.
#
#   NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://paid.example/robinhood,https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_ARC_RPC_URL=

# Local demo of the Club page: serves sample auction data from /api/club so
# /club can be seen before anything is deployed or indexed. Development only
# — ignored in a production build. Bidding still fails; there's no contract.
# CLUB_DEMO=1

# Goldsky subgraph serving the board — for a Robinhood build, the one built
# from subgraph/subgraph.robinhood.yaml. Deliberately NOT NEXT_PUBLIC_: the
# browser talks to /api/board, never to the indexer directly, so one query
# serves every viewer and the endpoint stays server-side.
#
# Without it the API falls back to reading logs straight from the RPC.
# That works, but re-scans history on every call and rate-limits quickly —
# a bootstrap convenience, not a mode to run on. See subgraph/.
SUBGRAPH_URL=

# Pinata JWT, from https://app.pinata.cloud — server-side only, never
# NEXT_PUBLIC_. This key WRITES to the Pinata account: anything holding it
# can pin content billed to you, which is why /api/upload is rate limited
# rather than merely keeping the key off the client.
#
# Without it /api/upload returns 503 and coins launch without pictures.
PINATA_JWT=

# Where invite codes are kept: a file, on a persistent volume in production.
# A code is a short stand-in for a signed invite, for people who would rather
# type something than click a link; see src/lib/server/invite-codes.ts. Unset,
# `next dev` keeps them in .data/ and a production build turns codes off, so
# members only get links — never a store that a redeploy silently wipes.
#
#   INVITE_STORE_PATH=/data/invite-codes.jsonl
INVITE_STORE_PATH=

# Dedicated Pinata gateway hostname, e.g. my-gateway.mypinata.cloud.
# Public by design — it only ever serves already-public IPFS content.
# Defaults to gateway.pinata.cloud, which is shared and slow enough to be
# noticeable on a board full of images.
NEXT_PUBLIC_PINATA_GATEWAY=
