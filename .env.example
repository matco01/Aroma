# Copy to .env.local and fill in. Everything here is public (NEXT_PUBLIC_),
# so nothing secret belongs in this file — the deployer key lives in
# contracts/.env, which is gitignored.

# Reown Cloud project ID — free, from https://cloud.reown.com
# Without it the app still runs, but only with injected browser wallets
# (MetaMask, Rabby). WalletConnect and the AppKit modal need this set.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Arc RPC endpoints, best first. Comma-separate to supply more than one
# and they go behind a fallback transport: if the first errors, the next is
# tried. Reads are cheap to retry, but the write path is the one that
# touches money — a single provider having a bad minute should not mean
# nobody can sell. The public endpoint alone has already rate-limited us.
#
#   NEXT_PUBLIC_ARC_RPC_URL=https://paid.example/arc,https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io

# Goldsky subgraph serving the board. Deliberately NOT NEXT_PUBLIC_: the
# browser talks to /api/board, never to the indexer directly, so one query
# serves every viewer and the endpoint stays server-side.
#
# Without it the API falls back to reading logs straight from the RPC.
# That works, but re-scans history on every call and rate-limits quickly —
# a bootstrap convenience, not a mode to run on. See subgraph/.
SUBGRAPH_URL=
